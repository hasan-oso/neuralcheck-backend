rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ===== شعار المحل =====
    // قراءة عامة (يُعرَض في صفحة المحل العلنية)، والكتابة لصاحب الحساب فقط.
    match /shops/{userId}/logo.jpg {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.uid == userId;
    }

    // ===== السلاسل الزمنية للفحص =====
    // يرفعها تطبيق العميل مباشرةً إلى scans/{deviceFingerprint}/{scanId}.ts.json.gz
    // (بما في ذلك جهاز الزبون المجهول في جلسات المحل). المسار مُفهرَس بـ
    // deviceFingerprint لا بـ uid، لذا لا يمكن تقييد الكتابة بـ uid — نكتفي
    // باشتراط وجود auth. القراءة مغلقة على العميل: الخادم يقرؤها عبر Admin SDK
    // الذي يتجاوز القواعد، ولا يقرأ أي عميل هذا المسار.
    match /scans/{fingerprint}/{file} {
      allow write: if request.auth != null;
      allow read: if false;
    }

    // ===== تقارير الـ PDF =====
    // تكتبها دالة generateReportPdf عبر Admin SDK (يتجاوز القواعد) وتُقرأ عبر
    // signed URL صالح 24 ساعة (يتجاوز القواعد أيضاً). لا حاجة لأي وصول مباشر
    // من العميل → مغلقة بالكامل.
    match /reports/{scanId}/{file} {
      allow read, write: if false;
    }

    // لا catch-all مفتوح: أي مسار غير مُطابَق أعلاه مرفوض افتراضياً (rules v2).
  }
}
